# ── LLM that drives the agent ────────────────────────────────────────────────
# openai | groq | anthropic | google | deepseek | openai-compatible
# (a key saved from the app under the model menu goes to that provider's own variable,
#  e.g. DEEPSEEK_API_KEY; VEIL_LLM_API_KEY is used when it's set)
VEIL_LLM_PROVIDER=openai
VEIL_LLM_MODEL=gpt-6-luna
VEIL_LLM_API_KEY=
# VEIL_LLM_BASE_URL=            # only for openai-compatible (OpenRouter, local vLLM, ...)
# VEIL_LLM_TEMPERATURE=         # leave unset: reasoning models reject custom temperatures

# ── Browser engine ───────────────────────────────────────────────────────────
# The chat app always runs Fortress (stealth Chromium). These variants are for the CLI
# (`veil run --engine ...`) and pipeline testing.
# fortress         native Fortress (Linux x64 / Windows x64)   <- use this
# fortress-docker  tilion/fortress image (macOS via Docker Desktop, any x64 host)
# cdp              a browser you started yourself (persona/proxy NOT applied)
# chromium         stock Chromium, NOT stealthy: pipeline testing only
VEIL_ENGINE=fortress
FORTRESS_CHANNEL=stable         # stable = Chromium 149 (blends in best) | latest = 151
VEIL_HEADLESS=true
# VEIL_CDP_URL=http://127.0.0.1:9222
# VEIL_CHROMIUM_PATH=

# ── IP rotation (pick one; neither = your own IP) ────────────────────────────
# A provider gateway. Put {session} where the provider expects its sticky-session
# token, so every veil session gets its own stable exit IP. Check your provider's
# docs for the exact username syntax.
# VEIL_PROXY_GATEWAY=http://USERNAME__cr.us;sessid.{session}:PASSWORD@gw.dataimpulse.com:823
#
# Or a list of static proxies, one per line (host:port:user:pass or scheme://user:pass@host:port)
# VEIL_PROXY_FILE=proxies.txt
# VEIL_PROXY_STRATEGY=round_robin   # round_robin | random | least_used

VEIL_GEO_MATCH=true              # align persona timezone/language with the proxy exit IP
VEIL_MAX_ATTEMPTS=3              # fresh identity per attempt when a site blocks
VEIL_MAX_STEPS=40
# VEIL_DATA_DIR=~/.veil          # sticky identities live here

# Reasoning effort, blank = provider default.
#   openai: minimal | low | medium | high | xhigh
#   anthropic: low | medium | high | xhigh | max
#   google: minimal | low | medium | high
#   deepseek: low | high | max    (thinking is on by default; blank/default = its default effort, high)
VEIL_LLM_EFFORT=

# Most browsers a split request runs at once ("create 2 accounts, one per profile").
# Each one is a full Fortress instance; the rest wait their turn.
VEIL_MAX_PARALLEL=3

# Most accounts one "Create accounts" request may make (each one is its own browser).
VEIL_MAX_BULK=25

# ── Automatic human checks (the agent is never told) ──────────────────────────
# Email one-time codes: add a mailbox app password (and, for an unusual host, its IMAP server) to
# a profile under Accounts. Gmail/Yahoo/Outlook-Hotmail/iCloud hosts are detected from the email;
# turn on IMAP and create an app-specific password (normal passwords with 2FA won't work).
# How long veil polls the mailbox for a code before falling back to the person:
VEIL_MAILBOX_WAIT=90

# CAPTCHA / bot-verification solving through a token service. Off unless a provider + key are set:
# 2captcha | capsolver
# VEIL_CAPTCHA_PROVIDER=2captcha
# VEIL_CAPTCHA_API_KEY=
# VEIL_CAPTCHA_TIMEOUT=120          # seconds one solve may take
# VEIL_CAPTCHA_MAX_SOLVES=2         # paid solves per page per run before asking the person

# Which proxy source runs use: direct | list | gateway.
# The Proxies panel sets this. VEIL_PROXY_FILE and VEIL_PROXY_GATEWAY stay saved
# even when they're not the one in use.
VEIL_PROXY_MODE=
